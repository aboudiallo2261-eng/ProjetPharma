# Normalisation des fins de ligne : LF dans le dépôt, natif dans le working tree
* text=auto

# Fichiers Windows toujours en CRLF
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Scripts shell toujours en LF
mvnw text eol=lf
*.sh text eol=lf

# Fichiers binaires (jamais de conversion)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.jar binary
*.class binary
*.pdf binary
*.xlsx binary
*.ttf binary
*.woff binary
*.woff2 binary
